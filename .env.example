# 외부 API 키 — 실제 값은 .env.local에 (gitignore 됨)
# 이 파일(.env.example)은 어떤 키가 필요한지 보여주는 템플릿이라 GitHub에 올라감.

# ─────────────────────────────────────────
# 1. Anthropic (Claude) — 대본·분석
# 발급: https://console.anthropic.com/settings/keys
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────
# 2. OpenAI — 썸네일·이미지 생성 (gpt-image)
# 발급: https://platform.openai.com/api-keys
# ─────────────────────────────────────────
OPENAI_API_KEY=

# ─────────────────────────────────────────
# 3. ElevenLabs — 음성 생성 (TTS)
# 발급: https://elevenlabs.io/app/settings/api-keys
# ─────────────────────────────────────────
ELEVENLABS_API_KEY=

# ─────────────────────────────────────────
# 4. YouTube Data API v3 — 레퍼런스 영상 자막·메타데이터 수집
# 발급: https://console.cloud.google.com/ → API 및 서비스 → 사용자 인증 정보
# ─────────────────────────────────────────
YOUTUBE_API_KEY=

# ─────────────────────────────────────────
# 5. (선택) 데이터베이스 — 채널/영상 이력 저장
# Vercel Postgres 또는 Neon 추천 (무료 티어 있음)
# ─────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────
# 6. Inngest — 백그라운드 큐 (분석/생성 등 장시간 작업)
# 로컬 dev에선 `npx inngest-cli@latest dev`가 자동 처리하므로 비워둬도 됨.
# 프로덕션 배포 시 https://app.inngest.com 에서 키 발급 후 입력.
# ─────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
